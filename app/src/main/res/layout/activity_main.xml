
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#EAF2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/studentconnect_illustration"
            android:contentDescription="Graduation illustration"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELCOME TO"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5275B8"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENTCONNECT"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#1746A2"
            android:gravity="center"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your one-stop platform for academic support, student announcements and help."
            android:textSize="16sp"
            android:textColor="#596579"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GET STARTED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1746A2"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your campus. Your support. One place."
        android:textSize="13sp"
        android:textColor="#52709F"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

</LinearLayout>
