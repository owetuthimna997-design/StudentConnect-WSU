
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FF"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:background="@android:color/white">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="← Back to Login"
                android:textColor="#1746A2"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDENTCONNECT"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1746A2"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your Student Number to verify your account."
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etForgotStudentNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Student Number"
                android:inputType="number"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnVerifyStudent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continue"
                android:layout_marginTop="20dp"
                android:backgroundTint="#1746A2" />

            <TextView
                android:id="@+id/txtSecurityQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etForgotSecurityAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your security answer"
                android:inputType="text"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnVerifyAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify Answer"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1746A2"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="New Password"
                android:inputType="textPassword"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etConfirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm New Password"
                android:inputType="textPassword"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1746A2"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
